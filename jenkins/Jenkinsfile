
pipeline {
    agent any

    options {
        timestamps()
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'CloudOps Enterprise Platform pipeline started.'
                checkout scm
            }
        }

        stage('Frontend Build') {
            steps {
                dir('frontend') {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Backend Build') {
            steps {
                dir('backend/cloudops-backend') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building CloudOps backend Docker image.'

                sh '''
                    docker build \
                        -t cloudops-backend:ci \
                        backend/cloudops-backend
                '''
            }
        }
    }

    post {
        success {
            echo 'CloudOps pipeline completed successfully.'
        }

        failure {
            echo 'CloudOps pipeline failed. Check the stage logs.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
